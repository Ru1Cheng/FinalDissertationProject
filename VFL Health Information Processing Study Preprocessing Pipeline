print(sep)

```
print("\n[Step 1/5]  Loading raw gaze data...")
gaze_raw = load_all_gaze(RAW_GAZE_DIR)

print("\n[Step 2/5]  Checking data quality...")
gaze_raw = flag_low_quality_trials(gaze_raw)

print("\n[Step 3/5]  Computing AOI metrics (dwell time, revisit count)...")
