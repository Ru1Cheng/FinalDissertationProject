# 5.  MERGE, VALIDATE, AND EXPORT

# ─────────────────────────────────────────────────────────────

def merge_datasets(
aoi_metrics: pd.DataFrame,
knowledge_scores: pd.DataFrame,
) -> pd.DataFrame:
“””
Left-join gaze metrics (poster-level) onto knowledge scores
(trial-level). Because knowledge scores are constant across
poster types within a trial, this correctly broadcasts trial-level
knowledge to all four poster rows.
“””
merge_keys = [“participant_id”, “trial_num”, “vfl_condition”, “vaccine_set”]
clean = aoi_metrics.merge(knowledge_scores, on=merge_keys, how=“left”)
return clean

def validate_dataset(clean_df: pd.DataFrame) -> None:
“”“Check shape, missing values, and range constraints.”””
actual_rows = len(clean_df)
print(f”\n  Shape check — Expected: {EXPECTED_ROWS} rows | Actual: {actual_rows} rows”)
if actual_rows != EXPECTED_ROWS:
print(
f”  [WARNING] Row count mismatch. “
f”Check for missing or duplicated trials.”
)

```
n_missing = clean_df.isnull().sum()
if n_missing.any():
    print("\n  [WARNING] Missing values detected:")
    print(n_missing[n_missing > 0])
else:
    print("  [OK] No missing values in cleaned dataset.")

# Range checks
assert clean_df["gist_score"].between(0, 4).all(), \
    "gist_score out of range [0–4]"
assert clean_df["eligibility_score"].between(0, 4).all(), \
    "eligibility_score out of range [0–4]"
assert clean_df["dwell_time_s"].ge(0).all(), \
    "Negative dwell time detected"
assert clean_df["revisit_count"].ge(0).all(), \
    "Negative revisit count detected"
assert clean_df["knowing_rate"].between(0, 1).all(), \
    "knowing_rate out of range [0–1]"
print("  [OK] All range checks passed.")
```

def export_outputs(clean_df: pd.DataFrame) -> None:
“”“Export cleaned dataset and summary statistics.”””
# Full dataset
dataset_path = OUTPUT_DIR / “cleaned_dataset.csv”
clean_df.to_csv(dataset_path, index=False)
print(f”\n  [SAVED] {dataset_path}”)

```
# Summary statistics by VFL condition (replicates Table 1 in dissertation)
summary_cols = [
    "dwell_time_s", "revisit_count",
    "verbatim_abs_dev", "gist_score", "eligibility_score",
]
# Aggregate at trial level (not poster level) for knowledge outcomes
trial_level = (
    clean_df
    .groupby(["participant_id", "trial_num", "vfl_condition"])[summary_cols]
    .mean()
    .reset_index()
)
summary = (
    trial_level
    .groupby("vfl_condition")[summary_cols]
    .agg(["mean", "std"])
    .round(2)
)
summary.columns = ["_".join(c) for c in summary.columns]

summary_path = OUTPUT_DIR / "summary_stats.csv"
summary.to_csv(summary_path)
print(f"  [SAVED] {summary_path}")

# Print to console (mirrors dissertation Table 1)
print("\n── Summary Statistics by VFL Condition ─────────────────────")
print(summary.to_string())
```

